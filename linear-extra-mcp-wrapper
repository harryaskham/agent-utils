#!/usr/bin/env bash
# linear-extra authenticates with the Linear session cookie (~/.pi/agent/linear-session.cookie);
# Linear's draft endpoint rejects API keys. Refresh it with `linear-extra-mcp login`.
export LINEAR_USER_ID="2e676734-9e83-4497-a699-e09b54637f07"
exec cltv-run linear-extra-mcp "$@"
