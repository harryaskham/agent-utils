# Pi 1.x installs git packages with `npm install --omit=dev --legacy-peer-deps`.
# Host modules belong in wildcard peerDependencies, never runtime dependencies:
# Pi's extension loader supplies the running host's modules. Pinned devDependencies
# support bare Node tests without shipping duplicate host modules into Pi.
# When loading this checkout as a local Pi package, use the same install flags;
# Pi does not manage dependencies for local packages.
package-lock=false
