# Pi 1.x installs git packages with `npm install --omit=dev --legacy-peer-deps`,
# and npm resolves devDependencies even when omitting them. Pi host modules are
# therefore wildcard peerDependencies only — never runtime or dev dependencies —
# so `pi update --extensions` never depends on a registry serving a particular
# host release. Bare Node tests get the host with `npm run host:install`, which
# matches the running Pi version without touching package.json.
# When loading this checkout as a local Pi package, use the same install flags;
# Pi does not manage dependencies for local packages.
package-lock=false
