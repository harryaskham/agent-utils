# Pi installs git packages with `npm install --omit=dev` and no lockfile.
# The Pi host packages are pinned runtime dependencies (package.json) so
# extensions that load them through jiti (editor chips' CustomEditor, the
# bundled pi-mcp-adapter) resolve real modules, and npm's peer resolution
# (pi-mcp-adapter wants pi-ai ^0.84) is satisfied instead of solving the
# `*` host peers to an incompatible newest release.
package-lock=false
