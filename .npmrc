# Pi provides @earendil-works/pi-* at runtime (loader aliases). Pi installs git
# packages with plain `npm install --omit=dev`, which would otherwise try to
# solve those host peers and fail (pi-mcp-adapter pins pi-ai ^0.84 while `*`
# resolves to the newest release), aborting `pi update --extensions`.
legacy-peer-deps=true
package-lock=false
