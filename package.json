{
  "name": "agent-utils",
  "version": "1.2.2",
  "description": "Agent utilities, MCP servers, and prompt templates",
  "keywords": [
    "pi-package"
  ],
  "author": {
    "name": "Harry Askham"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-session": "scripts/pi-session.mjs"
  },
  "files": [
    ".claude-plugin",
    "extensions",
    "android",
    "prompts",
    "scripts",
    "themes",
    "web-search",
    "crates",
    ".config/ss/config.yaml",
    "Cargo.toml",
    "Cargo.lock",
    "README.md",
    "flake.nix"
  ],
  "scripts": {
    "host:install": "node scripts/pi-host-install.mjs",
    "clean": "echo 'nothing to clean'",
    "build": "npm run docs:build",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:choice-ui": "python3 scripts/choice-ui-pty.py",
    "test:ptt-ui": "python3 scripts/ptt-shortcut-pty.py",
    "test:audio-ui": "python3 scripts/audio-providers-pty.py",
    "test:preview-reload": "PI_RUN_PREVIEW_RELOAD_SMOKE=1 node --test test/kitty-preview-real-reload.test.js",
    "test:preview-reload-pty": "python3 scripts/kitty-preview-reload-pty.py",
    "test:model-restore": "PI_RUN_MODEL_RESTORE_SMOKE=1 node --test test/copilot-restore-process.test.js",
    "test:compact-next-runtime": "PI_RUN_COMPACT_NEXT_RUNTIME=1 node --test --test-reporter=spec test/compact-next-runtime.test.js",
    "test:compact-next-ui": "python3 scripts/compact-next-pty.py",
    "test:pi-isolated": "PI_RUN_ISOLATED_EXTENSION_SMOKE=1 node --test --test-reporter=spec test/pi-isolated-extension-smoke.test.js",
    "test:coverage": "node --test --test-reporter=spec --experimental-test-coverage test/*.test.js",
    "test:coverage:summary": "node scripts/coverage-summary.mjs",
    "check": "npm run lint:workflows && npm run docs:check",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "docs:build": "python3 scripts/site/build.py",
    "docs:check": "python3 scripts/check-site.py",
    "pi-graphics:smoke": "node scripts/render-pi-graphics-smoke.mjs",
    "pi-graphics:animation-smoke": "node scripts/kitty-animation-smoke.mjs",
    "pi-graphics:tmux-smoke": "node scripts/test-pi-graphics-tmux-smoke.mjs",
    "pi-graphics:widget-smoke": "node scripts/test-kitty-image-preview-widget-smoke.mjs",
    "kitty-image-preview:render-smoke": "node scripts/kitty-image-preview-multi-image-render-smoke.mjs"
  },
  "dependencies": {
    "jiti": "2.7.0",
    "pi-mcp-adapter": "2.25.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typebox": "*",
    "ws": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/web-search.js",
      "./extensions/kitty-image-preview.js",
      "./extensions/shared-images.js",
      "./extensions/audio-reel.js",
      "./extensions/image-413-recovery.js",
      "./extensions/pi-graphics.js",
      "./extensions/editor-chips.js",
      "./extensions/cacophony-runtime.js",
      "./extensions/cacophony-mcp.js",
      "./extensions/firecracker-vm.js",
      "./extensions/audio-providers.js",
      "./extensions/realtime-agent.js",
      "./extensions/pipe.js",
      "./extensions/tts-queue.js",
      "./extensions/read-aloud.js",
      "./extensions/tts-narration.js",
      "./extensions/visual-thoughts.js",
      "./extensions/choice.js",
      "./extensions/herdr-input-state.js",
      "./extensions/omni-input.js",
      "./extensions/ring-input.js",
      "./extensions/force-agent-speech.js",
      "./extensions/compaction-continue-guard.js",
      "./extensions/compact-next.js",
      "./extensions/endless.js",
      "./extensions/after.js",
      "./extensions/cron.js",
      "./extensions/self-compact.js",
      "./extensions/session-fork.js",
      "./extensions/scrub.js",
      "./extensions/git-behind-warning.js",
      "./extensions/copilot-auth-refresh.js",
      "./extensions/copilot-model-identity.js",
      "./extensions/pi-self-update.js",
      "./extensions/effort.js",
      "./extensions/m.js",
      "./extensions/tendril-share.js",
      "./extensions/app-automation.js",
      "./extensions/slack-mcp.js",
      "./extensions/android.js",
      "./extensions/xvfb.js",
      "./extensions/nix-devshell.js",
      "./extensions/macos-native.js",
      "./extensions/cd.js"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes/eink.json",
      "./themes/kitty-graphics-nord.json",
      "./themes/kitty-graphics-nord-transparent.json",
      "./themes/kitty-graphics.json"
    ]
  }
}
